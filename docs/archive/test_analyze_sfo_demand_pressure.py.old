import csv
import importlib.util
import tempfile
import unittest
from pathlib import Path


MODULE_PATH = Path(__file__).resolve().parents[1] / "analyze_sfo_demand_pressure.py"
SPEC = importlib.util.spec_from_file_location("analyze_sfo_demand_pressure", MODULE_PATH)
MODULE = importlib.util.module_from_spec(SPEC)
assert SPEC.loader is not None
SPEC.loader.exec_module(MODULE)


class SfoDemandPressureTests(unittest.TestCase):
    def summary_rows(self) -> list[dict]:
        rows = []
        year, month = 2024, 5
        for index in range(24):
            previous = index < 12
            rows.append(
                {
                    "origin_airport_code": "SFO",
                    "origin_airport_name": "San Francisco International (SFO)",
                    "reporting_month": f"{year:04d}-{month:02d}-01T00:00:00.000",
                    "total_departures": "100" if previous else "110",
                    "total_passengers": "8000" if previous else "8800",
                    "total_seats": "10000" if previous else "11000",
                }
            )
            month += 1
            if month == 13:
                year += 1
                month = 1
        return rows

    def test_traffic_comparison_uses_weighted_totals_and_growth(self):
        result = MODULE.build_traffic_comparison(self.summary_rows())
        self.assertEqual(result["previous_period"]["weighted_load_factor"], 80.0)
        self.assertEqual(result["current_period"]["weighted_load_factor"], 80.0)
        self.assertEqual(result["changes"]["passenger_growth_percentage"], 10.0)
        self.assertEqual(result["changes"]["seat_growth_percentage"], 10.0)
        self.assertEqual(result["changes"]["departure_growth_percentage"], 10.0)

    def test_missing_summary_month_is_rejected(self):
        with self.assertRaisesRegex(ValueError, "Missing SFO summary months"):
            MODULE.build_traffic_comparison(self.summary_rows()[:-1])

    def test_route_supply_filters_and_counts_positive_shortfall(self):
        fieldnames = sorted(MODULE.ROUTE_REQUIRED_FIELDS)
        rows = []
        for year, month in sorted(
            MODULE.expected_months(
                MODULE.CURRENT_PERIOD_START, MODULE.CURRENT_PERIOD_END
            )
        ):
            rows.append(
                {
                    "DEPARTURES_SCHEDULED": "10",
                    "DEPARTURES_PERFORMED": "8",
                    "SEATS": "800",
                    "PASSENGERS": "700",
                    "ORIGIN": "SFO",
                    "YEAR": str(year),
                    "MONTH": str(month),
                    "CLASS": "F",
                }
            )
        rows.extend(
            [
                {
                    "DEPARTURES_SCHEDULED": "99",
                    "DEPARTURES_PERFORMED": "0",
                    "SEATS": "0",
                    "PASSENGERS": "0",
                    "ORIGIN": "LAX",
                    "YEAR": "2025",
                    "MONTH": "5",
                    "CLASS": "F",
                },
                {
                    "DEPARTURES_SCHEDULED": "99",
                    "DEPARTURES_PERFORMED": "0",
                    "SEATS": "0",
                    "PASSENGERS": "0",
                    "ORIGIN": "SFO",
                    "YEAR": "2025",
                    "MONTH": "5",
                    "CLASS": "G",
                },
            ]
        )

        with tempfile.TemporaryDirectory() as directory:
            source = Path(directory) / "routes.csv"
            with source.open("w", encoding="utf-8", newline="") as csv_file:
                writer = csv.DictWriter(csv_file, fieldnames=fieldnames)
                writer.writeheader()
                writer.writerows(rows)
            result = MODULE.build_route_supply_metrics((source,))

        self.assertEqual(result["scheduled_departures"], 120)
        self.assertEqual(result["performed_departures"], 96)
        self.assertEqual(result["scheduled_departures_not_operated"], 24)
        self.assertEqual(result["scheduled_service_shortfall_rate"], 20.0)
        self.assertEqual(
            result["estimated_seats_on_unoperated_scheduled_departures"], 2400
        )

    def test_assessment_does_not_claim_direct_unmet_demand(self):
        traffic = {
            "current_period": {"weighted_load_factor": 86.0},
            "changes": {
                "passenger_growth_percentage": 6.0,
                "seat_growth_percentage": 3.0,
            },
        }
        supply = {"scheduled_service_shortfall_rate": 2.0}
        result = MODULE.build_assessment(traffic, supply)
        self.assertEqual(result["demand_pressure_level"], "strong")
        self.assertFalse(result["direct_unmet_passenger_demand_measured"])


if __name__ == "__main__":
    unittest.main()
