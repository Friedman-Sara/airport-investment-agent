import unittest

try:
    from scripts import fetch_on_time_congestion as congestion
except ModuleNotFoundError:
    import fetch_on_time_congestion as congestion


def make_row(
    year,
    month,
    *,
    flights="1",
    dep_del_15="1",
    dep_delay_minutes="20",
    taxi_out="10",
    cancelled="0",
    diverted="0",
):
    return {
        "Year": str(year),
        "Month": str(month),
        "FlightDate": f"{year}-{month:02d}-01",
        "Reporting_Airline": "ZZ",
        "Origin": "LAX",
        "Dest": "SFO",
        "Flights": flights,
        "DepDel15": dep_del_15,
        "DepDelayMinutes": dep_delay_minutes,
        "TaxiOut": taxi_out,
        "Cancelled": cancelled,
        "Diverted": diverted,
        "CarrierDelay": "10" if dep_del_15 else "",
        "WeatherDelay": "0" if dep_del_15 else "",
        "NASDelay": "5" if dep_del_15 else "",
        "SecurityDelay": "0" if dep_del_15 else "",
        "LateAircraftDelay": "5" if dep_del_15 else "",
    }


class CongestionMetricTests(unittest.TestCase):
    def test_percentage_and_average_handle_zero_denominator(self):
        self.assertIsNone(
            congestion.percentage(
                congestion.Decimal("1"), congestion.Decimal("0")
            )
        )
        self.assertIsNone(
            congestion.average(
                congestion.Decimal("10"), congestion.Decimal("0")
            )
        )

    def test_summary_exposes_denominators_and_calculates_metrics(self):
        metrics = congestion.empty_metrics()

        for year, month in congestion.MONTHS:
            congestion.process_row(make_row(year, month), metrics)

        # A cancelled row has no departure-delay or taxi-out observation.
        congestion.process_row(
            make_row(
                2025,
                5,
                dep_del_15="",
                dep_delay_minutes="",
                taxi_out="",
                cancelled="1",
            ),
            metrics,
        )

        summary = congestion.build_airport_summary("LAX", metrics)

        self.assertEqual(summary["months_returned"], 12)
        self.assertEqual(summary["scheduled_flights"], 13)
        self.assertEqual(summary["operated_flights"], 12)
        self.assertEqual(summary["delay_eligible_flights"], 12)
        self.assertEqual(summary["delayed_15_flights"], 12)
        self.assertEqual(summary["departure_delay_rate"], 100.0)
        self.assertEqual(summary["departure_delay_observations"], 12)
        self.assertEqual(summary["average_departure_delay_minutes"], 20.0)
        self.assertEqual(summary["taxi_out_observations"], 12)
        self.assertEqual(summary["average_taxi_out_minutes"], 10.0)
        self.assertEqual(summary["cancelled_flights"], 1)
        self.assertEqual(summary["cancellation_rate"], 7.69)
        self.assertEqual(
            summary["delay_cause_mix"]["CarrierDelay"]["percentage"],
            50.0,
        )

    def test_incomplete_period_is_rejected(self):
        metrics = congestion.empty_metrics()
        for year, month in congestion.MONTHS[:-1]:
            congestion.process_row(make_row(year, month), metrics)

        with self.assertRaisesRegex(ValueError, "Missing LAX months: 2026-04"):
            congestion.build_airport_summary("LAX", metrics)

    def test_missing_header_is_rejected(self):
        fields = [
            field
            for field in congestion.SELECTED_FIELDS
            if field != "TaxiOut"
        ]

        with self.assertRaisesRegex(ValueError, "TaxiOut"):
            congestion.validate_header(fields, "test.csv")


if __name__ == "__main__":
    unittest.main()
